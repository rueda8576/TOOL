{
  "name": "doctoral-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @doctoral/api dev",
    "dev:web": "pnpm --filter @doctoral/web dev",
    "dev:worker": "pnpm --filter @doctoral/worker dev",
    "test": "pnpm -r test",
    "test:ci": "pnpm --filter @doctoral/shared build && pnpm --filter @doctoral/db db:test:prepare && pnpm --filter @doctoral/api test:coverage && pnpm --filter @doctoral/worker test:coverage:gate && pnpm build",
    "test:ci:gate": "pnpm --filter @doctoral/shared build && pnpm --filter @doctoral/db db:test:prepare && pnpm --filter @doctoral/api test:coverage:gate && pnpm --filter @doctoral/worker test:coverage:gate && pnpm build",
    "lint": "eslint .",
    "repo:check": "node scripts/repo-check.mjs",
    "test:e2e": "pnpm --filter @doctoral/web test:e2e",
    "test:visual": "pnpm --filter @doctoral/web test:visual",
    "test:a11y": "pnpm --filter @doctoral/web test:a11y",
    "test:qa": "pnpm --filter @doctoral/web test:qa",
    "format": "pnpm -r format",
    "db:generate": "pnpm --filter @doctoral/db db:generate",
    "db:migrate": "pnpm --filter @doctoral/db db:migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.0",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.19",
    "globals": "17.6.0",
    "typescript-eslint": "8.61.1"
  }
}
