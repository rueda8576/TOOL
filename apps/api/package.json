{
  "name": "@doctoral/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "seed:admin": "ts-node-dev --transpile-only src/scripts/seed-admin.ts",
    "lint": "echo 'No lint configured for @doctoral/api'",
    "test": "pnpm run test:unit",
    "test:unit": "jest --config jest.config.ts --runInBand",
    "test:unit:coverage": "jest --config jest.config.ts --runInBand --coverage --coverageReporters=text-summary",
    "test:coverage": "node scripts/run-coverage.cjs",
    "test:coverage:gate": "node scripts/run-coverage.cjs --threshold=95",
    "test:http": "jest --config jest.http.config.ts --runInBand",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "lib0": "^0.2.117",
    "multer": "^1.4.5-lts.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.19.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
