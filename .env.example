NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctoral_platform?schema=public
REDIS_URL=redis://localhost:6379
# Docker Compose overrides these local URLs with service hostnames by default.
# Set these only when Compose should connect to external services.
ATLASIUM_DOCKER_DATABASE_URL=
ATLASIUM_DOCKER_REDIS_URL=
JWT_SECRET=change-me-in-production
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
STORAGE_ROOT=./storage
APP_BASE_URL=http://localhost:3000
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_EXTERNAL_URL=https://git.atlasium.info
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_DEFAULT_NAMESPACE_ID=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:4000/auth/gitlab/callback
GITLAB_SYSTEM_ACCESS_TOKEN=
GITLAB_SYSTEM_USER_ID=
GITLAB_MANAGED_GROUP_ID=
GITLAB_MANAGED_GROUP_PATH=atlasium
GITLAB_MANAGED_GROUP_NAME=Atlasium
GITLAB_OMNIBUS_IMAGE=gitlab/gitlab-ce:latest
ATLASIUM_GITLAB_ROOT=/var/lib/atlasium/gitlab
ATLASIUM_GITLAB_HTTP_PORT=8081
GITLAB_ROOT_EMAIL=root@git.atlasium.info
GITLAB_INITIAL_ROOT_PASSWORD=
ATLASIUM_OIDC_CLIENT_ID=atlasium-gitlab
ATLASIUM_OIDC_CLIENT_SECRET=
ATLASIUM_OIDC_PRIVATE_KEY_BASE64=
ATLASIUM_SESSION_COOKIE_NAME=atlasium_session
API_PORT=4000
WORKER_HEALTH_PORT=4100
WEB_PORT=3000
DEFAULT_TIMEZONE=Europe/Madrid
PDF_UPLOAD_LIMIT_BYTES=1073741824
LATEX_TIMEOUT_MS=120000
BACKUP_RETENTION_DAYS=30
AI_MEETING_AUTOMATION_ENABLED=false
AI_MAX_INPUT_CHARS=50000
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=45000
ATLASIUM_STORAGE_HOST_PATH=./storage
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
